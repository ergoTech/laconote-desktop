{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "dashboard-remote",
    "description": "Allow laconote.com pages in dashboard window to call IPC (save_token after login)",
    "windows": ["dashboard"],
    "remote": {
        "urls": ["https://laconote.com/*", "https://*.laconote.com/*"]
    },
    "permissions": [
        "core:default",
        "notification:default",
        "store:default",
        "opener:default"
    ]
}
